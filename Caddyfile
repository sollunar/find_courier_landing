{
	# Xray owns the public TLS port. Caddy terminates only the local
	# REALITY target connection forwarded by Xray.
	https_port {$CAMOUFLAGE_PORT}
	default_bind 127.0.0.1
	auto_https off

	# REALITY over RAW is TCP-only. Do not advertise an unreachable
	# HTTP/3 endpoint on the internal HTTPS port.
	servers 127.0.0.1:{$CAMOUFLAGE_PORT} {
		protocols h1 h2
	}
}

# Certificates are provisioned outside this repository and mounted read-only.
# Caddy receives neither certificate-management logic nor provider credentials.
https://{$CAMOUFLAGE_DOMAIN} {
	tls /certs/fullchain.pem /certs/privkey.pem
	root * /srv/find-courier

	encode zstd gzip
	try_files {path} {path}/ /index.html
	file_server

	log {
		output stdout
		format json
	}
}
